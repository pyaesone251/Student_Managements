                    <button name="action_create" string="Create" type="object" class="btn btn-outline-success"/>
                    <button name="action_search" string="Search" type="object" class="btn btn-outline-warning"/>
                    <button name="action_write" string="Write" type="object" class="btn btn-outline-secondary"/>
                    <button name="action_all_write" string="ALl Write" type="object" class="btn btn-outline-secondary"/>
                    <button name="action_delete" string="Delete" type="object" class="btn btn-outline-danger"/>
