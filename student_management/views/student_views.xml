<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.form</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create" string="Create" type="object" class="btn btn-outline-success"/>
                    <button name="action_search" string="Search" type="object" class="btn btn-outline-warning" />
                </header>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="age" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="view_student_list" model="ir.ui.view">
        <field name="name">student.list</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="age" />
            </list>
        </field>
    </record>

    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="student_menu_root" name="Students" sequence="10" />
    <menuitem id="student_menu" action="action_student" parent="student_menu_root" sequence="10" />
</odoo>